			<ShortName>description</ShortName>
			<LongName>Description (nl)</LongName>
			<Data Type="string" Lang="nl"/>
		</Column>
		<Column Id="titleEn" Use="required">
			<ShortName>titleEn</ShortName>
			<LongName>Title (en)</LongName>
			<Data Type="string" Lang="en"/>
		</Column>
		<Column Id="descriptionEn" Use="required">
			<ShortName>descriptionEn</ShortName>
			<LongName>Description (en)</LongName>
			<Data Type="string" Lang="en"/>
		</Column>
		<Key Id="codeKey">
			<ShortName>codeKey</ShortName>
			<ColumnRef Ref="code"/>
		</Key>
	</ColumnSet>
	<SimpleCodeList>
		<Row>
			<Value ColumnRef="code"><SimpleValue>Down</SimpleValue></Value>
			<Value ColumnRef="name"><SimpleValue>Uitgevallen</SimpleValue></Value>
			<Value ColumnRef="description"><SimpleValue>De installatie is niet beschikbaar.</SimpleValue></Value>
			<Value ColumnRef="titleEn"><SimpleValue>Down</SimpleValue></Value>
			<Value ColumnRef="descriptionEn"><SimpleValue>The installation is not available.</SimpleValue></Value>
		</Row>
		<Row>
			<Value ColumnRef="code"><SimpleValue>ExternallyDisabled</SimpleValue></Value>
			<Value ColumnRef="name"><SimpleValue>Extern uitgeschakeld</SimpleValue></Value>
			<Value ColumnRef="description"><SimpleValue>De installatie is door een externe partij buiten werking gesteld.</SimpleValue></Value>
			<Value ColumnRef="titleEn"><SimpleValue>Externally disabled</SimpleValue></Value>
			<Value ColumnRef="descriptionEn"><SimpleValue>The installation has been taken out of operation by an external party.</SimpleValue></Value>
		</Row>
		<Row>
			<Value ColumnRef="code"><SimpleValue>TemporarilyDisabled</SimpleValue></Value>
			<Value ColumnRef="name"><SimpleValue>Tijdelijk uitgeschakeld</SimpleValue></Value>
			<Value ColumnRef="description"><SimpleValue>De installatie is tijdelijk buiten gebruik gesteld.</SimpleValue></Value>
			<Value ColumnRef="titleEn"><SimpleValue>Temporarily disabled</SimpleValue></Value>
			<Value ColumnRef="descriptionEn"><SimpleValue>The installation has been temporarily taken out of use.</SimpleValue></Value>
		</Row>
		<Row>
			<Value ColumnRef="code"><SimpleValue>Standby</SimpleValue></Value>
			<Value ColumnRef="name"><SimpleValue>Stand-by</SimpleValue></Value>
			<Value ColumnRef="description"><SimpleValue>De installatie is beschikbaar maar inactief.</SimpleValue></Value>
			<Value ColumnRef="titleEn"><SimpleValue>Standby</SimpleValue></Value>
			<Value ColumnRef="descriptionEn"><SimpleValue>The installation is available but inactive.</SimpleValue></Value>
		</Row>
		<Row>
			<Value ColumnRef="code"><SimpleValue>Operational</SimpleValue></Value>
			<Value ColumnRef="name"><SimpleValue>Operationeel</SimpleValue></Value>
			<Value ColumnRef="description"><SimpleValue>De installatie functioneert normaal.</SimpleValue></Value>
			<Value ColumnRef="titleEn"><SimpleValue>Operational</SimpleValue></Value>
			<Value ColumnRef="descriptionEn"><SimpleValue>The installation is functioning normally.</SimpleValue></Value>
		</Row>
		<Row>
			<Value ColumnRef="code"><SimpleValue>Degraded</SimpleValue></Value>
			<Value ColumnRef="name"><SimpleValue>Verminderd</SimpleValue></Value>
			<Value ColumnRef="description"><SimpleValue>De installatie functioneert beperkt.</SimpleValue></Value>
			<Value ColumnRef="titleEn"><SimpleValue>Degraded</SimpleValue></Value>
			<Value ColumnRef="descriptionEn"><SimpleValue>The installation is functioning in a limited way.</SimpleValue></Value>
