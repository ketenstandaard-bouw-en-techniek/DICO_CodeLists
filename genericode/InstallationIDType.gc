<?xml version="1.0" encoding="UTF-8"?>
<gc:CodeList xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
	<Identification>
		<ShortName>InstallationIDType</ShortName>
		<LongName xml:lang="en">Installation ID Type</LongName>
		<LongName xml:lang="nl">Type installatie-ID</LongName>
		<Version>2026-10-08</Version>
		<CanonicalUri>https://www.ketenstandaard.nl/codelist/dico/InstallationIDType</CanonicalUri>
		<CanonicalVersionUri>https://www.ketenstandaard.nl/codelist/dico/InstallationIDType/2026-10-08</CanonicalVersionUri>
		<Agency>
			<LongName>Ketenstandaard Bouw en Techniek</LongName>
		</Agency>
	</Identification>
	<ColumnSet>
		<Column Id="code" Use="required">
			<ShortName>code</ShortName>
			<LongName>Code</LongName>
			<Data Type="string"/>
		</Column>
		<Column Id="titleEn" Use="required">
			<ShortName>titleEn</ShortName>
			<LongName>Title (en)</LongName>
			<Data Type="string" Lang="en"/>
		</Column>
		<Column Id="titleNl" Use="required">
			<ShortName>titleNl</ShortName>
			<LongName>Title (nl)</LongName>
			<Data Type="string" Lang="nl"/>
		</Column>
		<Key Id="codeKey">
			<ShortName>codeKey</ShortName>
			<ColumnRef Ref="code"/>
		</Key>
	</ColumnSet>
	<SimpleCodeList>
		<Row>
			<Value ColumnRef="code"><SimpleValue>GUID</SimpleValue></Value>
			<Value ColumnRef="titleEn"><SimpleValue>A globally unique identifier or GUID is a pseudo-random number used in software applications, which is assumed to be globally unique.</SimpleValue></Value>
			<Value ColumnRef="titleNl"><SimpleValue>Een globally unique identifier of GUID is een pseudowillekeurig getal dat gebruikt wordt in softwaretoepassingen, en dat verondersteld wordt wereldwijd uniek te zijn.</SimpleValue></Value>
		</Row>
		<Row>
			<Value ColumnRef="code"><SimpleValue>GIAI</SimpleValue></Value>
			<Value ColumnRef="titleEn"><SimpleValue>The GS1 Global Individual Asset Identifier (GIAI) is a GS1 key for the identification of assets.</SimpleValue></Value>
			<Value ColumnRef="titleNl"><SimpleValue>Het GS1 Global Individual Asset Identifier (GIAI) is een GS1 sleutel voor identificatie van assets.</SimpleValue></Value>
		</Row>
	</SimpleCodeList>
</gc:CodeList>
