<?xml version="1.0" encoding="UTF-8"?>
<gc:CodeList xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
	<Identification>
		<ShortName>LcaDeclarationIndicatorType</ShortName>
		<LongName xml:lang="en">LCA Declaration Indicator Type</LongName>
		<LongName xml:lang="nl">LCA-declaratie-indicator</LongName>
		<Version>2026-10-08</Version>
		<CanonicalUri>https://www.ketenstandaard.nl/codelist/dico/LcaDeclarationIndicatorType</CanonicalUri>
		<CanonicalVersionUri>https://www.ketenstandaard.nl/codelist/dico/LcaDeclarationIndicatorType/2026-10-08</CanonicalVersionUri>
		<Agency>
			<LongName>Ketenstandaard Bouw en Techniek</LongName>
		</Agency>
	</Identification>
	<ColumnSet>
		<Column Id="code" Use="required">
			<ShortName>code</ShortName>
			<LongName>Code</LongName>
			<Data Type="string"/>
		</Column>
		<Column Id="titleEn" Use="required">
			<ShortName>titleEn</ShortName>
			<LongName>Title (en)</LongName>
			<Data Type="string" Lang="en"/>
		</Column>
		<Column Id="titleNl" Use="required">
			<ShortName>titleNl</ShortName>
			<LongName>Title (nl)</LongName>
			<Data Type="string" Lang="nl"/>
		</Column>
		<Key Id="codeKey">
			<ShortName>codeKey</ShortName>
			<ColumnRef Ref="code"/>
		</Key>
	</ColumnSet>
	<SimpleCodeList>
		<Row>
			<Value ColumnRef="code"><SimpleValue>MND</SimpleValue></Value>
			<Value ColumnRef="titleEn"><SimpleValue>Module not declared</SimpleValue></Value>
			<Value ColumnRef="titleNl"><SimpleValue>Module niet gedeclareerd</SimpleValue></Value>
		</Row>
		<Row>
			<Value ColumnRef="code"><SimpleValue>MNR</SimpleValue></Value>
			<Value ColumnRef="titleEn"><SimpleValue>Module not relevant</SimpleValue></Value>
			<Value ColumnRef="titleNl"><SimpleValue>Module niet relevant</SimpleValue></Value>
		</Row>
		<Row>
			<Value ColumnRef="code"><SimpleValue>AGG</SimpleValue></Value>
			<Value ColumnRef="titleEn"><SimpleValue>Only for stages A1, A2 and A3 - to indicate that results are aggregated (combined) under code A1-A3</SimpleValue></Value>
			<Value ColumnRef="titleNl"><SimpleValue>Alleen voor fasen A1, A2 en A3 - om aan te geven dat resultaten zijn geaggregeerd (gecombineerd) onder code A1-A3</SimpleValue></Value>
		</Row>
		<Row>
			<Value ColumnRef="code"><SimpleValue>MDE</SimpleValue></Value>
			<Value ColumnRef="titleEn"><SimpleValue>Module declared</SimpleValue></Value>
			<Value ColumnRef="titleNl"><SimpleValue>Module gedeclareerd</SimpleValue></Value>
		</Row>
	</SimpleCodeList>
</gc:CodeList>
