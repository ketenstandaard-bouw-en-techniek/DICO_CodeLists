			<Value ColumnRef="titleEn"><SimpleValue>Request for information</SimpleValue></Value>
			<Value ColumnRef="descriptionEn"><SimpleValue>Information request to the contractor</SimpleValue></Value>
			<Value ColumnRef="mainStatusEffectEn"><SimpleValue>Main status unchanged</SimpleValue></Value>
			<Value ColumnRef="mainStatusEffectNl"><SimpleValue>Hoofdstatus ongewijzigd</SimpleValue></Value>
			<Value ColumnRef="initiatorEn"><SimpleValue>Contractor</SimpleValue></Value>
			<Value ColumnRef="initiatorNl"><SimpleValue>Opdrachtnemer</SimpleValue></Value>
		</Row>
		<Row>
			<Value ColumnRef="code"><SimpleValue>AIN</SimpleValue></Value>
			<Value ColumnRef="name"><SimpleValue>Aanleveren aanvullende informatie</SimpleValue></Value>
