<?xml version="1.0" encoding="UTF-8"?>
<gc:CodeList xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
	<Identification>
		<ShortName>EventCode</ShortName>
		<LongName xml:lang="en">Event Code</LongName>
		<LongName xml:lang="nl">Eventcode</LongName>
		<Version>1.0</Version>
		<CanonicalUri>https://www.ketenstandaard.nl/codelist/dico/EventCode</CanonicalUri>
		<CanonicalVersionUri>https://www.ketenstandaard.nl/codelist/dico/EventCode/1.0</CanonicalVersionUri>
		<Agency>
			<LongName>Ketenstandaard Bouw en Techniek</LongName>
		</Agency>
	</Identification>
	<ColumnSet>
		<Column Id="code" Use="required">
			<ShortName>code</ShortName>
			<LongName>Code</LongName>
			<Data Type="string"/>
		</Column>
		<Column Id="name" Use="required">
			<ShortName>name</ShortName>
			<LongName>Name (nl)</LongName>
			<Data Type="string" Lang="nl"/>
		</Column>
		<Column Id="description" Use="required">
			<ShortName>description</ShortName>
			<LongName>Description (nl)</LongName>
			<Data Type="string" Lang="nl"/>
		</Column>
		<Column Id="titleEn" Use="required">
			<ShortName>titleEn</ShortName>
			<LongName>Title (en)</LongName>
			<Data Type="string" Lang="en"/>
		</Column>
		<Column Id="descriptionEn" Use="required">
			<ShortName>descriptionEn</ShortName>
			<LongName>Description (en)</LongName>
			<Data Type="string" Lang="en"/>
		</Column>
		<Column Id="mainStatusEffectEn" Use="required">
			<ShortName>mainStatusEffectEn</ShortName>
			<LongName>Effect on main status (en)</LongName>
			<Data Type="string" Lang="en"/>
		</Column>
		<Column Id="mainStatusEffectNl" Use="required">
			<ShortName>mainStatusEffectNl</ShortName>
			<LongName>Effect on main status (nl)</LongName>
			<Data Type="string" Lang="nl"/>
		</Column>
		<Column Id="initiatorEn" Use="required">
			<ShortName>initiatorEn</ShortName>
			<LongName>Initiator (en)</LongName>
			<Data Type="string" Lang="en"/>
		</Column>
		<Column Id="initiatorNl" Use="required">
			<ShortName>initiatorNl</ShortName>
			<LongName>Initiator (nl)</LongName>
			<Data Type="string" Lang="nl"/>
		</Column>
		<Key Id="codeKey">
			<ShortName>codeKey</ShortName>
			<ColumnRef Ref="code"/>
		</Key>
	</ColumnSet>
	<SimpleCodeList>
		<Row>
			<Value ColumnRef="code"><SimpleValue>ONH</SimpleValue></Value>
			<Value ColumnRef="name"><SimpleValue>Onderbroken</SimpleValue></Value>
			<Value ColumnRef="description"><SimpleValue>Opdracht wordt op pauze gezet; optioneel redencode</SimpleValue></Value>
			<Value ColumnRef="titleEn"><SimpleValue>On hold</SimpleValue></Value>
			<Value ColumnRef="descriptionEn"><SimpleValue>The order is put on hold; reason code optional</SimpleValue></Value>
			<Value ColumnRef="mainStatusEffectEn"><SimpleValue>Main status unchanged</SimpleValue></Value>
			<Value ColumnRef="mainStatusEffectNl"><SimpleValue>Hoofdstatus ongewijzigd</SimpleValue></Value>
			<Value ColumnRef="initiatorEn"><SimpleValue>Contractor</SimpleValue></Value>
			<Value ColumnRef="initiatorNl"><SimpleValue>Opdrachtnemer</SimpleValue></Value>
		</Row>
		<Row>
			<Value ColumnRef="code"><SimpleValue>REX</SimpleValue></Value>
			<Value ColumnRef="name"><SimpleValue>Hervatten</SimpleValue></Value>
			<Value ColumnRef="description"><SimpleValue>Hervat uitvoering na Onderbroken</SimpleValue></Value>
			<Value ColumnRef="titleEn"><SimpleValue>Resume</SimpleValue></Value>
			<Value ColumnRef="descriptionEn"><SimpleValue>Resumes execution after On hold</SimpleValue></Value>
			<Value ColumnRef="mainStatusEffectEn"><SimpleValue>Main status unchanged</SimpleValue></Value>
			<Value ColumnRef="mainStatusEffectNl"><SimpleValue>Hoofdstatus ongewijzigd</SimpleValue></Value>
			<Value ColumnRef="initiatorEn"><SimpleValue>Contractor</SimpleValue></Value>
			<Value ColumnRef="initiatorNl"><SimpleValue>Opdrachtnemer</SimpleValue></Value>
		</Row>
		<Row>
