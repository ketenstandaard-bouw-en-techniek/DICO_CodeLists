			<Value ColumnRef="titleEn"><SimpleValue>Provide additional information</SimpleValue></Value>
			<Value ColumnRef="descriptionEn"><SimpleValue>Answer to VIN; can also be sent by the client on its own initiative</SimpleValue></Value>
			<Value ColumnRef="mainStatusEffectEn"><SimpleValue>Main status unchanged</SimpleValue></Value>
			<Value ColumnRef="mainStatusEffectNl"><SimpleValue>Hoofdstatus ongewijzigd</SimpleValue></Value>
			<Value ColumnRef="initiatorEn"><SimpleValue>Client</SimpleValue></Value>
			<Value ColumnRef="initiatorNl"><SimpleValue>Opdrachtgever</SimpleValue></Value>
		</Row>
		<Row>
			<Value ColumnRef="code"><SimpleValue>VER</SimpleValue></Value>
			<Value ColumnRef="name"><SimpleValue>Verlengen doorlooptijd</SimpleValue></Value>
			<Value ColumnRef="description"><SimpleValue>Melding verlenging; optioneel redencode</SimpleValue></Value>
			<Value ColumnRef="titleEn"><SimpleValue>Extend lead time</SimpleValue></Value>
			<Value ColumnRef="descriptionEn"><SimpleValue>Notification of extension; reason code optional</SimpleValue></Value>
			<Value ColumnRef="mainStatusEffectEn"><SimpleValue>Main status unchanged</SimpleValue></Value>
			<Value ColumnRef="mainStatusEffectNl"><SimpleValue>Hoofdstatus ongewijzigd</SimpleValue></Value>
			<Value ColumnRef="initiatorEn"><SimpleValue>Contractor</SimpleValue></Value>
			<Value ColumnRef="initiatorNl"><SimpleValue>Opdrachtnemer</SimpleValue></Value>
		</Row>
		<Row>
			<Value ColumnRef="code"><SimpleValue>AFH</SimpleValue></Value>
			<Value ColumnRef="name"><SimpleValue>Afspraak huurder</SimpleValue></Value>
			<Value ColumnRef="description"><SimpleValue>Afspraakmelding met datum/tijd; optioneel redencode</SimpleValue></Value>
			<Value ColumnRef="titleEn"><SimpleValue>Tenant appointment</SimpleValue></Value>
			<Value ColumnRef="descriptionEn"><SimpleValue>Appointment notification with date/time; reason code optional</SimpleValue></Value>
			<Value ColumnRef="mainStatusEffectEn"><SimpleValue>Main status unchanged</SimpleValue></Value>
			<Value ColumnRef="mainStatusEffectNl"><SimpleValue>Hoofdstatus ongewijzigd</SimpleValue></Value>
			<Value ColumnRef="initiatorEn"><SimpleValue>Contractor</SimpleValue></Value>
			<Value ColumnRef="initiatorNl"><SimpleValue>Opdrachtnemer</SimpleValue></Value>
