<?xml version="1.0" encoding="UTF-8"?>
<gc:CodeList xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
	<Identification>
		<ShortName>LifeCycleStageType</ShortName>
		<LongName xml:lang="en">Life Cycle Stage Type</LongName>
		<LongName xml:lang="nl">Levenscyclusfase</LongName>
